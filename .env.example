# Copy to .env and fill in. NEVER commit .env.

MEDVANI_ENV=development                 # set to "production" on the server (hides /docs)
MEDVANI_LOG_LEVEL=INFO

# Comma-separated keys clients must send in the X-API-Key header. Empty = auth disabled.
MEDVANI_API_KEYS=

# Comma-separated browser origins allowed to call the API. Empty = no CORS.
MEDVANI_CORS_ORIGINS=

# Set true ONLY when running behind a trusted reverse proxy (Render, Fly, Cloud Run, nginx).
MEDVANI_TRUST_PROXY=false
MEDVANI_RATE_LIMIT_PER_MINUTE=30
MEDVANI_MAX_QUERY_CHARS=1000
MEDVANI_HISTORY_MAX_TURNS=4
MEDVANI_TOP_K=3
MEDVANI_MIN_SCORE=0.12

# Translation: "offline" (Hindi + English, no key needed) or "llm" (any OpenAI-compatible API)
MEDVANI_TRANSLATOR=offline
MEDVANI_LLM_BASE_URL=https://api.openai.com/v1
MEDVANI_LLM_API_KEY=
MEDVANI_LLM_MODEL=

# Optional LangSmith tracing. Leave OFF in production: traces would send users' health
# text to a third party. Enable only with user consent and a data agreement.
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
